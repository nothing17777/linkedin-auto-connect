{
  "manifest_version": 3,
  "name": "LinkedIn Auto Connect",
  "version": "1.1",
  "description": "Clicks Connect on suggestions in LinkedIn's My Network > Grow page, with delays and a cap.",
  "action": {
    "default_title": "LinkedIn Auto Connect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/mynetwork/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}